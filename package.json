{
  "name": "control-ai-desktop",
  "version": "1.0.0",
  "description": "Control AI - Assistente local autonomo",
  "main": "desktop/electron/main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --win",
    "build:installer": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.controlai.desktop",
    "productName": "Control AI",
    "asarUnpack": [
      "backend/**/*",
      "scripts/**/*"
    ],
    "files": [
      "desktop/**/*",
      "backend/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "ControlAI-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "axios": "^1.7.7"
  },
  "devDependencies": {
    "electron": "^32.1.2",
    "electron-builder": "^24.13.3"
  }
}
